{
  "name": "dsh-session-resume",
  "version": "0.1.0",
  "description": "Offers to pick up a conversation that was still running when DSH last closed: the interrupted turn is detected from the session log and shown as a resume prompt.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "resume",
    "recovery"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "author": "879745uhjun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-session-resume.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-session-resume#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-session-resume/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
